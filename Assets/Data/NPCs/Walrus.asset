  m_Script: {fileID: 11500000, guid: 8b4da19336b54fa4ebf67db148f50e9c, type: 3}
  m_Name: Walrus
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: Walrus
  defaultConversationKey: default
  conversations:
  - key: default
    dialogueLine:
      npcText: Whoa ho ho! Maybe you really ARE creative! Origami... Don't suppose
        you'd trade some Scraps for it...?
      choices:
      - choiceText: Uh sure
        endsConversation: 0
        setsConversationKey: 
        action: 0
        actionParam: 
        nextLine:
          npcText: You don't know about Scraps!? Pastels and paste...
          choices:
          - choiceText: wow that's a lot...
            endsConversation: 0
            setsConversationKey: 
            action: 0
            actionParam: 
            nextLine:
              npcText: Every bit of creativity takes something from the world and
                makes it into something new. One Ittle Scrap is another Ittle masterpiece,
                am I right?
              choices:
              - choiceText: You want me to draw more?
                endsConversation: 0
                setsConversationKey: 
                action: 0
                actionParam: 
                nextLine:
                  npcText: Anything you create can be added into the world with a
                    little Scrap. Here, I'll give you some of mine. Make  some art
                    and put it into the world!
                  choices:
                  - choiceText: I'll make something
                    endsConversation: 1
                    setsConversationKey: ittle_wait_commission
                    action: 1
                    actionParam: walrus_placement_quest
                    nextLine:
                      npcText: 
