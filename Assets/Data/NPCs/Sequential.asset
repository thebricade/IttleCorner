  conversations:
  - key: default
    dialogueLine:
      npcText: Let's make something together step by step! First - draw a simple
        shape.
      choices:
      - choiceText: Let's go!
        endsConversation: 0
        setsConversationKey: sequential_wait_1
        action: 1
        actionParam: sequential_test_quest
        nextLine:
          npcText: 
          choices: []
          nextLineKey: 
      nextLineKey: 
  - key: sequential_wait_1
    dialogueLine:
      npcText: Great shape! Now show me.
      choices:
      - choiceText: Done
        endsConversation: 0
        setsConversationKey: 
        action: 2
        actionParam: sequential_test_quest
        nextLine:
          npcText: 
          choices: []
          nextLineKey: 
      - choiceText: Still working
        endsConversation: 1
        setsConversationKey: 
        action: 0
        actionParam: 
        nextLine:
          npcText: 
          choices: []
          nextLineKey: 
      nextLineKey: 
  - key: testshape_prompt_1
    dialogueLine:
      npcText: Nice! Now turn that shape into something. Add some details.
      choices:
