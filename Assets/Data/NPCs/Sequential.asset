      - choiceText: Done
        endsConversation: 0
        setsConversationKey: 
        action: 2
        actionParam: sequential_test_quest
        nextLine:
          npcText: 
          choices: []
          nextLineKey: 
      - choiceText: Still working
        endsConversation: 1
        setsConversationKey: 
        action: 0
        actionParam: 
        nextLine:
          npcText: 
          choices: []
          nextLineKey: 
      nextLineKey: 
  - key: testshape_prompt_2
    dialogueLine:
      npcText: Amazing! Last step - give it a face!
      choices:
      - choiceText: Here we go!
        endsConversation: 0
        setsConversationKey: sequential_wait_3
        action: 1
        actionParam: sequential_test_quest
        nextLine:
          npcText: 
          choices: []
          nextLineKey: 
      nextLineKey: 
  - key: sequential_wait_3
    dialogueLine:
      npcText: Let me see the final thing!
      choices:
      - choiceText: Done
        endsConversation: 0
        setsConversationKey: 
